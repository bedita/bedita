{
    "name": "bedita/api",
    "type": "cakephp-plugin",
    "description": "A plugin to enable REST API in any BEdita application.",
    "keywords": ["cakephp", "cake3", "plugin", "bedita", "api", "rest", "travis", "scrutinizer", "coveralls"],
    "license": "LGPL-3.0-or-later",
    "support": {
        "source": "https://github.com/bedita/bedita",
        "issues": "https://github.com/bedita/bedita/issues"
    },
    "authors": [
        {
            "name": "Chia Lab s.r.l.",
            "email": "dev@chialab.it",
            "homepage": "http://www.chialab.it"
        },
        {
            "name": "ChannelWeb s.r.l.",
            "email": "info@channelweb.it",
            "homepage": "http://www.channelweb.it"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/authentication": "^3.0.3",
        "cakephp/authorization": "^3.1.2",
        "cakephp/cakephp": "5.1.*",
        "firebase/php-jwt": "^6.9"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "BEdita\\API\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEdita\\API\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
