<?xml version="1.0"?>
<ruleset name="App">
    <arg name="colors"/>
    <arg value="n" />
    <arg value="p" />
    <arg name="extensions" value="php"/>

    <config name="installed_paths" value="../../cakephp/cakephp-codesniffer"/>

    <rule ref="CakePHP"/>
    <file>src/</file>
    <file>tests/</file>
    <file>plugins/BEdita/API/src/</file>
    <file>plugins/BEdita/API/tests/</file>
    <file>plugins/BEdita/Core/src/</file>
    <file>plugins/BEdita/Core/tests/</file>
</ruleset>
